# Goban Configuration Environment Variables
# Copy this file to config/.env and fill in your values
# DO NOT commit .env files with real secrets!

# Server configuration
GOBAN_PORT=8081

# Database type: sqlite or postgres
DB_TYPE=postgres

# PostgreSQL connection (required if DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nanami
DB_PASSWORD=your-secure-password-here
DB_NAME=goban

# Alternative: use ${VAR} syntax in config.yaml files instead
# Example: db_password: "${GOBAN_DB_PASSWORD}"
